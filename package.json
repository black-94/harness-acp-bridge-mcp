{
  "name": "@black942026/harness-acp-bridge-mcp",
  "version": "0.1.9",
  "type": "module",
  "description": "Stdio MCP proxy for the harness-acp-bridge HTTP server: exposes its operations as tools without owning harnesses, state, or scheduling.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/black-94/harness-acp-bridge-mcp.git"
  },
  "homepage": "https://github.com/black-94/harness-acp-bridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/black-94/harness-acp-bridge-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "acp",
    "harness",
    "bridge",
    "http",
    "proxy"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "config.example.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "harness-acp-bridge-mcp": "dist/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "node scripts/redaction-parity.mjs",
    "check": "npm run clean && npm run build && npm run typecheck && npm test",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@black942026/harness-acp-bridge-server": "^0.1.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
